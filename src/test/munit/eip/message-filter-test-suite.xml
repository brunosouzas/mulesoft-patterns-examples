			<munit-tools:assert-that doc:name="Caller is told DISCARDED" expression="#[vars.response.result]" is="#[MunitTools::equalTo('DISCARDED')]" />
			<munit-tools:assert-that doc:name="Reservations: 0" expression="#[payload.reservations]" is="#[MunitTools::equalTo(0)]" />
			<munit-tools:verify-call doc:name="Reservation called 0x" processor="flow-ref" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="sf-reserve-stock-for-order" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="filter-after-paid-order-is-reserved" description="Message filter after: a paid order passes the filter and is reserved once">
		<munit:execution>
			<munit:set-event doc:name="Order ORD-MF-A-PAID (PAID)">
				<munit:payload value="#[output application/json --- {orderId: 'ORD-MF-A-PAID', status: 'PAID', items: [{sku: 'SKU-BOOK', quantity: 2}, {sku: 'SKU-MUG', quantity: 1}]}]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="POST /eip/stock/after/reservations" name="stock-after-reserve-paid-orders" />
			<set-variable doc:name="Reservation response" variableName="response" value="#[payload]" />
			<munit:set-event doc:name="GET reservations" cloneOriginalEvent="true">
