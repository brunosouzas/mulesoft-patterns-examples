	</munit:test>

	<munit:test name="filter-request-without-items-returns-400" description="Message filter: an order event without items is rejected with 400 before the filter">
		<munit:execution>
			<munit:set-event doc:name="Order without items">
				<munit:payload value="#[output application/json --- {orderId: 'ORD-MF-BAD', status: 'PAID'}]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="POST /eip/stock/after/reservations" name="stock-after-reserve-paid-orders" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="400" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(400)]" />
		</munit:validation>
	</munit:test>
</mule>
