<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

	<!--
		Transactional client: two writes (ledger debit, order PAID) that must succeed or fail together. The failure
		tests mock the Object Store write with OS:STORE_NOT_AVAILABLE and call the endpoints over HTTP; the GET shows
		what each version left in the stores.
	-->
	<munit:config name="transactional-client-test-suite.xml" />

	<munit:test name="tc-both-writes-succeed" description="Transactional client: when both writes succeed, before and after answer 200 PAID and the ledger and the order both hold the payment">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="payment-charge-in-try-transaction" />
			<munit:enable-flow-source value="payment-charge-with-compensation" />
			<munit:enable-flow-source value="payment-get-transactional-state" />
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request doc:name="POST before" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/before" target="vBefore" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-1', amount: 50 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="POST after" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/after" target="vAfter" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-2', amount: 70 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="GET state 1" config-ref="eip-self-http-request-config" method="GET" path="/eip/payments/transactional/ORD-TC-1" target="vState1" targetValue="#[output application/java --- { status: attributes.statusCode, body: payload }]">
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="GET state 2" config-ref="eip-self-http-request-config" method="GET" path="/eip/payments/transactional/ORD-TC-2" target="vState2" targetValue="#[output application/java --- { status: attributes.statusCode, body: payload }]">
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Before 200" expression="#[vars.vBefore.status]" is="#[MunitTools::equalTo(200)]" />
			<munit-tools:assert-that doc:name="Before JSON" expression="#[vars.vBefore.contentType]" is="#[MunitTools::startsWith('application/json')]" />
			<munit-tools:assert-that doc:name="Before PAID" expression="#[vars.vBefore.body]" is="#[MunitTools::equalTo({ orderId: 'ORD-TC-1', status: 'PAID' })]" />
			<munit-tools:assert-that doc:name="After 200" expression="#[vars.vAfter.status]" is="#[MunitTools::equalTo(200)]" />
			<munit-tools:assert-that doc:name="After PAID" expression="#[vars.vAfter.body.status]" is="#[MunitTools::equalTo('PAID')]" />
			<munit-tools:assert-that doc:name="Debit 1" expression="#[vars.vState1.body.ledgerDebit]" is="#[MunitTools::equalTo({ orderId: 'ORD-TC-1', amount: 50, entry: 'DEBIT' })]" />
			<munit-tools:assert-that doc:name="Order 1 paid" expression="#[vars.vState1.body.orderStatus]" is="#[MunitTools::equalTo('PAID')]" />
			<munit-tools:assert-that doc:name="Debit 2" expression="#[vars.vState2.body.ledgerDebit.amount]" is="#[MunitTools::equalTo(70)]" />
			<munit-tools:assert-that doc:name="Order 2 paid" expression="#[vars.vState2.body.orderStatus]" is="#[MunitTools::equalTo('PAID')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="tc-before-try-transaction-does-not-roll-back-the-debit" description="Transactional client, before: the second write fails inside the Try; the caller gets 500 and the ledger debit stays, the order is not paid. The Try holds no transactional resource, so this shows the outcome, not an effect of ALWAYS_BEGIN">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="payment-charge-in-try-transaction" />
			<munit:enable-flow-source value="payment-charge-with-compensation" />
			<munit:enable-flow-source value="payment-get-transactional-state" />
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mark Order Paid fails" processor="os:store">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark Order Paid" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="OS:STORE_NOT_AVAILABLE" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request doc:name="POST before" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/before" target="vBefore" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-3', amount: 50 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="GET state" config-ref="eip-self-http-request-config" method="GET" path="/eip/payments/transactional/ORD-TC-3" target="vState" targetValue="#[output application/java --- { status: attributes.statusCode, body: payload }]">
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="500" expression="#[vars.vBefore.status]" is="#[MunitTools::equalTo(500)]" />
			<munit-tools:assert-that doc:name="JSON" expression="#[vars.vBefore.contentType]" is="#[MunitTools::startsWith('application/json')]" />
			<munit-tools:assert-that doc:name="Debit left behind" expression="#[vars.vState.body.ledgerDebit.amount]" is="#[MunitTools::equalTo(50)]" />
			<munit-tools:assert-that doc:name="Order not paid" expression="#[vars.vState.body.orderStatus]" is="#[MunitTools::nullValue()]" />
		</munit:validation>
	</munit:test>

	<munit:test name="tc-after-compensation-undoes-the-debit" description="Transactional client, after: the second write fails; the compensation removes the debit, the caller gets 503 in JSON and neither record is left">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="payment-charge-in-try-transaction" />
			<munit:enable-flow-source value="payment-charge-with-compensation" />
			<munit:enable-flow-source value="payment-get-transactional-state" />
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mark Order Paid fails" processor="os:store">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark Order Paid" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="OS:STORE_NOT_AVAILABLE" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request doc:name="POST after" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/after" target="vAfter" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-4', amount: 50 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="GET state" config-ref="eip-self-http-request-config" method="GET" path="/eip/payments/transactional/ORD-TC-4" target="vState" targetValue="#[output application/java --- { status: attributes.statusCode, body: payload }]">
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="503" expression="#[vars.vAfter.status]" is="#[MunitTools::equalTo(503)]" />
			<munit-tools:assert-that doc:name="JSON" expression="#[vars.vAfter.contentType]" is="#[MunitTools::startsWith('application/json')]" />
			<munit-tools:assert-that doc:name="Says why" expression="#[vars.vAfter.body.error]" is="#[MunitTools::equalTo('Payment not recorded; the ledger debit was undone')]" />
			<munit-tools:assert-that doc:name="No debit" expression="#[vars.vState.body.ledgerDebit]" is="#[MunitTools::nullValue()]" />
			<munit-tools:assert-that doc:name="Order not paid" expression="#[vars.vState.body.orderStatus]" is="#[MunitTools::nullValue()]" />
		</munit:validation>
	</munit:test>

	<munit:test name="tc-after-first-write-fails-nothing-to-undo" description="Transactional client, after: when the ledger debit itself fails there is nothing to undo; the caller still gets 503 and nothing is written">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="payment-charge-in-try-transaction" />
			<munit:enable-flow-source value="payment-charge-with-compensation" />
			<munit:enable-flow-source value="payment-get-transactional-state" />
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when doc:name="Write Ledger Debit fails" processor="os:store">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Write Ledger Debit" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="OS:STORE_NOT_AVAILABLE" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request doc:name="POST after" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/after" target="vAfter" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-5', amount: 20 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="GET state" config-ref="eip-self-http-request-config" method="GET" path="/eip/payments/transactional/ORD-TC-5" target="vState" targetValue="#[output application/java --- { status: attributes.statusCode, body: payload }]">
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="503" expression="#[vars.vAfter.status]" is="#[MunitTools::equalTo(503)]" />
			<munit-tools:assert-that doc:name="No debit" expression="#[vars.vState.body.ledgerDebit]" is="#[MunitTools::nullValue()]" />
			<munit-tools:assert-that doc:name="Order not paid" expression="#[vars.vState.body.orderStatus]" is="#[MunitTools::nullValue()]" />
		</munit:validation>
	</munit:test>

	<munit:test name="tc-invalid-payment-is-rejected" description="Transactional client: a payment without a positive amount gets 400 in JSON from both endpoints">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="payment-charge-in-try-transaction" />
			<munit:enable-flow-source value="payment-charge-with-compensation" />
			<munit:enable-flow-source value="payment-get-transactional-state" />
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request doc:name="POST before" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/before" target="vBefore" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-6', amount: 0 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="POST after" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/after" target="vAfter" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { amount: 10 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Before 400" expression="#[vars.vBefore.status]" is="#[MunitTools::equalTo(400)]" />
			<munit-tools:assert-that doc:name="JSON" expression="#[vars.vBefore.contentType]" is="#[MunitTools::startsWith('application/json')]" />
			<munit-tools:assert-that doc:name="Says why" expression="#[vars.vBefore.body.error]" is="#[MunitTools::equalTo('orderId and a positive amount are required')]" />
			<munit-tools:assert-that doc:name="After 400" expression="#[vars.vAfter.status]" is="#[MunitTools::equalTo(400)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="tc-second-payment-of-an-order-is-refused" description="Transactional client: a second payment of an order already paid gets 409 in JSON from both endpoints, and the first debit is not replaced">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="payment-charge-in-try-transaction" />
			<munit:enable-flow-source value="payment-charge-with-compensation" />
			<munit:enable-flow-source value="payment-get-transactional-state" />
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request doc:name="POST after" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/after" target="vFirst" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-7', amount: 40 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="POST after again" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/after" target="vAgain" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-7', amount: 90 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="POST before again" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/before" target="vBeforeAgain" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-7', amount: 90 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="GET state" config-ref="eip-self-http-request-config" method="GET" path="/eip/payments/transactional/ORD-TC-7" target="vState" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="First 200" expression="#[vars.vFirst.status]" is="#[MunitTools::equalTo(200)]" />
			<munit-tools:assert-that doc:name="Again 409" expression="#[vars.vAgain.status]" is="#[MunitTools::equalTo(409)]" />
			<munit-tools:assert-that doc:name="JSON" expression="#[vars.vAgain.contentType]" is="#[MunitTools::startsWith('application/json')]" />
			<munit-tools:assert-that doc:name="Says why" expression="#[vars.vAgain.body.error]" is="#[MunitTools::equalTo('Order already has a payment')]" />
			<munit-tools:assert-that doc:name="Before 409" expression="#[vars.vBeforeAgain.status]" is="#[MunitTools::equalTo(409)]" />
			<munit-tools:assert-that doc:name="First debit kept" expression="#[vars.vState.body.ledgerDebit.amount]" is="#[MunitTools::equalTo(40)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="tc-after-failed-compensation-answers-500" description="Transactional client, after: the second write fails and the undo of the debit fails too; the caller gets 500 compensation failed in JSON, not 503, and the debit is still recorded">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="payment-charge-in-try-transaction" />
			<munit:enable-flow-source value="payment-charge-with-compensation" />
			<munit:enable-flow-source value="payment-get-transactional-state" />
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mark Order Paid fails" processor="os:store">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Mark Order Paid" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="OS:STORE_NOT_AVAILABLE" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Undo Ledger Debit fails" processor="os:remove">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Undo Ledger Debit" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="OS:STORE_NOT_AVAILABLE" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request doc:name="POST after" config-ref="eip-self-http-request-config" method="POST" path="/eip/payments/transactional/after" target="vAfter" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-TC-8', amount: 60 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<http:request doc:name="GET state" config-ref="eip-self-http-request-config" method="GET" path="/eip/payments/transactional/ORD-TC-8" target="vState" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="500" expression="#[vars.vAfter.status]" is="#[MunitTools::equalTo(500)]" />
			<munit-tools:assert-that doc:name="JSON" expression="#[vars.vAfter.contentType]" is="#[MunitTools::startsWith('application/json')]" />
			<munit-tools:assert-that doc:name="Says why" expression="#[vars.vAfter.body.error]" is="#[MunitTools::equalTo('Payment not recorded and the compensation failed: the ledger debit is still recorded')]" />
			<munit-tools:assert-that doc:name="Debit still there" expression="#[vars.vState.body.ledgerDebit.amount]" is="#[MunitTools::equalTo(60)]" />
			<munit-tools:assert-that doc:name="Order not paid" expression="#[vars.vState.body.orderStatus]" is="#[MunitTools::nullValue()]" />
		</munit:validation>
	</munit:test>
</mule>
