		http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

	<!--
		Process manager: every call goes over HTTP to this app. The simulated services reply on their own, from
		an Async scope, so the tests poll the process state (Until Successful) until it ends instead of sleeping.
		The duplicate and invalid-reply tests mock the command to the services, so the process waits at its step
		and the test sends the replies itself. The stores are persistent, so they are cleared before each test.
	-->
	<munit:config name="process-manager-test-suite.xml" />

	<munit:before-test name="pm-clear-stores" description="Starts each test with no processes and no reply receipts">
		<os:clear doc:name="Clear Processes" objectStore="eip-pm-process-store" />
		<os:clear doc:name="Clear Receipts" objectStore="eip-pm-receipts-store" />
	</munit:before-test>

	<munit:test name="pm-happy-path-completes" description="Process manager: an order is paid, its stock reserved and invoiced by services that reply asynchronously; the process ends COMPLETED with the whole history">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="process-manager-start-order" />
			<munit:enable-flow-source value="process-manager-receive-reply" />
			<munit:enable-flow-source value="process-manager-get-process" />
			<munit:enable-flow-source value="process-manager-simulated-service" />
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request doc:name="POST start" config-ref="eip-self-http-request-config" method="POST" path="/eip/process-manager/orders" target="vStart" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
				<http:body><![CDATA[#[output application/json --- { orderId: 'ORD-PM-1', amount: 100, sku: 'SKU-BOOK', quantity: 2 }]]]></http:body>
				<http:response-validator>
					<http:success-status-code-validator values="200..599" />
				</http:response-validator>
			</http:request>
			<until-successful doc:name="Wait for the end" maxRetries="50" millisBetweenRetries="100">
				<http:request doc:name="GET process" config-ref="eip-self-http-request-config" method="GET" path="#['/eip/process-manager/processes/' ++ vars.vStart.body.processId]" target="vState" targetValue="#[output application/java --- { status: attributes.statusCode, contentType: attributes.headers.'content-type' default '', body: payload }]">
					<http:response-validator>
						<http:success-status-code-validator values="200..599" />
					</http:response-validator>
				</http:request>
				<choice doc:name="Check Reached">
					<when expression="#[not (['COMPLETED','FAILED','CANCELLED'] contains vars.vState.body.status)]">
						<raise-error doc:name="Raise TEST:NOT_YET Error" type="TEST:NOT_YET" description="Not yet" />
					</when>
				</choice>
			</until-successful>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="202" expression="#[vars.vStart.status]" is="#[MunitTools::equalTo(202)]" />
			<munit-tools:assert-that doc:name="JSON" expression="#[vars.vStart.contentType]" is="#[MunitTools::startsWith('application/json')]" />
			<munit-tools:assert-that doc:name="Started RUNNING" expression="#[vars.vStart.body.status]" is="#[MunitTools::equalTo('RUNNING')]" />
			<munit-tools:assert-that doc:name="First step PAYMENT" expression="#[vars.vStart.body.currentStep]" is="#[MunitTools::equalTo('PAYMENT')]" />
			<munit-tools:assert-that doc:name="COMPLETED" expression="#[vars.vState.body.status]" is="#[MunitTools::equalTo('COMPLETED')]" />
			<munit-tools:assert-that doc:name="No current step" expression="#[vars.vState.body.currentStep]" is="#[MunitTools::nullValue()]" />
			<munit-tools:assert-that doc:name="Ended at" expression="#[vars.vState.body.endedAt]" is="#[MunitTools::notNullValue()]" />
			<munit-tools:assert-that doc:name="History" expression="#[vars.vState.body.history map ((h) -> h.step ++ ':' ++ h.event ++ (if (h.outcome != null) ':' ++ h.outcome else ''))]" is="#[MunitTools::equalTo(['PAYMENT:SENT','PAYMENT:REPLY:APPROVED','STOCK:SENT','STOCK:REPLY:RESERVED','INVOICE:SENT','INVOICE:REPLY:ISSUED'])]" />
		</munit:validation>
	</munit:test>

