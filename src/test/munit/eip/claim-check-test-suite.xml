<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!--
		Claim check: a 200 KB order document is checked in, only the claim key travels to the archive, the archive
		and later callers check the document out with the key, and after the store's time to live (3 seconds in
		app.yaml) the claim is gone. The expiry test waits 5 seconds, longer than the TTL plus the 1-second
		expiration interval.
	-->
	<munit:config name="claim-check-test-suite.xml" />

	<munit:test name="cc-only-the-claim-travels-and-the-archive-checks-the-document-out" description="Claim check: the archive receives orderId, claimKey and fileName only, and still archives the whole 200,000-byte document it fetched with the key">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="archive-store-order-document" />
		</munit:enable-flow-sources>
		<munit:execution>
			<munit:set-event doc:name="Order ORD-CC-1 with a 200 KB document">
				<munit:payload value="#[output application/json --- {orderId: 'ORD-CC-1', document: {fileName: 'po-ORD-CC-1.pdf', mediaType: 'application/pdf', contentBase64: dw::core::Binaries::toBase64(dw::core::Strings::repeat('PDF-', 50000) as Binary)}}]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="POST /eip/orders/documents" name="order-check-in-document" />
			<set-variable doc:name="SET vCheckIn" variableName="vCheckIn" value="#[payload]" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="202: no error status set" expression="#[vars.httpStatus]" is="#[MunitTools::nullValue()]" />
			<munit-tools:assert-that doc:name="Claim key issued" expression="#[payload.claimKey startsWith 'CLM-']" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Archive received only the claim" expression="#[payload.archive.receivedFields]" is="#[MunitTools::equalTo(['orderId', 'claimKey', 'fileName'])]" />
			<munit-tools:assert-that doc:name="Archive got the whole document with the key" expression="#[payload.archive.sizeBytes]" is="#[MunitTools::equalTo(200000)]" />
			<munit-tools:assert-that doc:name="Archived file" expression="#[payload.archive.fileName]" is="#[MunitTools::equalTo('po-ORD-CC-1.pdf')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="cc-check-out-does-not-remove-the-document" description="Claim check: after the archive has checked the document out, the same claim key still returns it to another caller, unchanged">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="archive-store-order-document" />
		</munit:enable-flow-sources>
		<munit:execution>
			<munit:set-event doc:name="Order ORD-CC-2 with a 200 KB document">
				<munit:payload value="#[output application/json --- {orderId: 'ORD-CC-2', document: {fileName: 'po-ORD-CC-2.pdf', mediaType: 'application/pdf', contentBase64: dw::core::Binaries::toBase64(dw::core::Strings::repeat('PDF-', 50000) as Binary)}}]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="POST /eip/orders/documents" name="order-check-in-document" />
			<set-variable doc:name="SET vCheckIn" variableName="vCheckIn" value="#[payload]" />
			<munit:set-event cloneOriginalEvent="true" doc:name="GET the document by its claim key">
				<munit:attributes value="#[{uriParams: {claimKey: vars.vCheckIn.claimKey}}]" />
			</munit:set-event>
			<flow-ref doc:name="GET /eip/orders/documents/{claimKey}" name="order-check-out-document" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="200: no error status set" expression="#[vars.httpStatus]" is="#[MunitTools::nullValue()]" />
			<munit-tools:assert-that doc:name="Same order" expression="#[payload.orderId]" is="#[MunitTools::equalTo('ORD-CC-2')]" />
			<munit-tools:assert-that doc:name="Same content" expression="#[payload.contentBase64 == dw::core::Binaries::toBase64(dw::core::Strings::repeat('PDF-', 50000) as Binary)]" is="#[MunitTools::equalTo(true)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="cc-claim-expires-after-its-time-to-live" description="Claim check: 5 seconds after check-in (TTL 3 s, expiration every 1 s) the claim key returns 404">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="archive-store-order-document" />
		</munit:enable-flow-sources>
		<munit:execution>
			<munit:set-event doc:name="Order ORD-CC-3 with a 200 KB document">
				<munit:payload value="#[output application/json --- {orderId: 'ORD-CC-3', document: {fileName: 'po-ORD-CC-3.pdf', mediaType: 'application/pdf', contentBase64: dw::core::Binaries::toBase64(dw::core::Strings::repeat('PDF-', 50000) as Binary)}}]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="POST /eip/orders/documents" name="order-check-in-document" />
			<set-variable doc:name="SET vCheckIn" variableName="vCheckIn" value="#[payload]" />
			<munit-tools:sleep doc:name="Wait past the claim's time to live" time="5" timeUnit="SECONDS" />
			<munit:set-event cloneOriginalEvent="true" doc:name="GET the document by its claim key">
				<munit:attributes value="#[{uriParams: {claimKey: vars.vCheckIn.claimKey}}]" />
			</munit:set-event>
			<flow-ref doc:name="GET /eip/orders/documents/{claimKey}" name="order-check-out-document" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Archived before it expired" expression="#[vars.vCheckIn.archive.sizeBytes]" is="#[MunitTools::equalTo(200000)]" />
			<munit-tools:assert-that doc:name="404" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(404)]" />
			<munit-tools:assert-that doc:name="Reason" expression="#[payload.error]" is="#[MunitTools::equalTo('claim ' ++ vars.vCheckIn.claimKey ++ ' not found or expired')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="cc-unknown-claim-returns-404-at-the-archive" description="Claim check: a claim message whose key was never issued gets 404 from the archive, and nothing is archived">
		<munit:execution>
			<munit:set-event doc:name="Claim message with an unknown key">
				<munit:payload value="#[output application/json --- {orderId: 'ORD-CC-4', claimKey: 'CLM-unknown', fileName: 'po.pdf'}]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="POST /eip/archive/documents" name="archive-store-order-document" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="404" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(404)]" />
			<munit-tools:verify-call doc:name="Nothing archived" processor="ee:transform" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Archive Document (simulated)" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="cc-order-without-document-returns-400" description="Claim check: an order without document content is rejected with 400 and nothing is checked in">
		<munit:execution>
			<munit:set-event doc:name="Order without content">
				<munit:payload value="#[output application/json --- {orderId: 'ORD-CC-5', document: {fileName: 'po.pdf'}}]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="POST /eip/orders/documents" name="order-check-in-document" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="400" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(400)]" />
			<munit-tools:verify-call doc:name="Nothing checked in" processor="os:store" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="Check In Order Document" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
</mule>
