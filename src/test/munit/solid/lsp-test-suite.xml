<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<munit:config name="lsp-test-suite.xml" />

	<munit:test name="lsp-before-legacy-pending" description="LSP before: legacy provider - pending order can be cancelled">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' }, queryParams: { provider: 'legacy' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-before-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Can cancel" expression="#[payload.canCancel]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Total" expression="#[payload.totalPrice]" is="#[MunitTools::equalTo(120)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-before-new-pending-breaks" description="LSP before: new provider - same order, consumer silently says it cannot be cancelled">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' }, queryParams: { provider: 'new' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-before-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Wrong decision" expression="#[payload.canCancel]" is="#[MunitTools::equalTo(false)]" />
			<munit-tools:assert-that doc:name="Status vocabulary" expression="#[payload.status]" is="#[MunitTools::equalTo('pending')]" />
			<munit-tools:assert-that doc:name="Price as text" expression="#[payload.totalPrice]" is="#[MunitTools::equalTo('120.00')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-before-new-unknown-breaks" description="LSP before: new provider - unknown order returns 200 with empty data instead of 404">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-0000' }, queryParams: { provider: 'new' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-before-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="No error status" expression="#[vars.httpStatus]" is="#[MunitTools::nullValue()]" />
			<munit-tools:assert-that doc:name="Empty order" expression="#[payload.orderId]" is="#[MunitTools::nullValue()]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-after-legacy-pending" description="LSP after: legacy provider - pending order can be cancelled">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' }, queryParams: { provider: 'legacy' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-after-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Can cancel" expression="#[payload.canCancel]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Total" expression="#[payload.totalPrice]" is="#[MunitTools::equalTo(120)]" />
			<munit-tools:assert-that doc:name="Status" expression="#[payload.status]" is="#[MunitTools::equalTo('PENDING')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-after-legacy-shipped" description="LSP after: legacy provider - shipped order">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1002' }, queryParams: { provider: 'legacy' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-after-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Result" expression="#[payload]" is="#[MunitTools::equalTo({orderId: 'ORD-1002', status: 'SHIPPED', totalPrice: 75.5, canCancel: false})]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-after-legacy-unknown" description="LSP after: legacy provider - unknown order is 404">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-0000' }, queryParams: { provider: 'legacy' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-after-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="HTTP status" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(404)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-after-new-pending" description="LSP after: new provider - pending order can be cancelled">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' }, queryParams: { provider: 'new' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-after-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Can cancel" expression="#[payload.canCancel]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Total" expression="#[payload.totalPrice]" is="#[MunitTools::equalTo(120)]" />
			<munit-tools:assert-that doc:name="Status" expression="#[payload.status]" is="#[MunitTools::equalTo('PENDING')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-after-new-shipped" description="LSP after: new provider - shipped order">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1002' }, queryParams: { provider: 'new' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-after-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Result" expression="#[payload]" is="#[MunitTools::equalTo({orderId: 'ORD-1002', status: 'SHIPPED', totalPrice: 75.5, canCancel: false})]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-after-new-unknown" description="LSP after: new provider - unknown order is 404">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-0000' }, queryParams: { provider: 'new' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-after-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="HTTP status" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(404)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-before-legacy-unknown" description="LSP before: legacy provider - unknown order is 404">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-0000' }, queryParams: { provider: 'legacy' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-before-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="HTTP status" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(404)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-before-invalid-provider" description="LSP before: unknown provider is rejected">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' }, queryParams: { provider: 'sap' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-before-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="HTTP status" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(400)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="lsp-after-invalid-provider" description="LSP after: unknown provider is rejected">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' }, queryParams: { provider: 'sap' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="lsp-after-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="HTTP status" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(400)]" />
		</munit:validation>
	</munit:test>
</mule>
