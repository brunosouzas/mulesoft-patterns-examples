<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<munit:config name="isp-test-suite.xml" />

	<munit:test name="isp-before-returns-everything" description="ISP before: every consumer gets billing and internal data">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="isp-before-get-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Internal cost exposed" expression="#[payload.internal.costPrice]" is="#[MunitTools::equalTo(70)]" />
			<munit-tools:assert-that doc:name="Customer exposed" expression="#[payload.customer.email]" is="#[MunitTools::equalTo('alex.doe@example.com')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="isp-after-mobile-view" description="ISP after: mobile gets tracking data only">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="isp-after-get-mobile-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Fields" expression="#[keysOf(payload) map $ as String]" is="#[MunitTools::equalTo(['orderId', 'status', 'estimatedDelivery'])]" />
			<munit-tools:assert-that doc:name="Status" expression="#[payload.status]" is="#[MunitTools::equalTo('SHIPPED')]" />
		</munit:validation>
	</munit:test>

	<munit:test name="isp-after-finance-view" description="ISP after: finance gets billing data only">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-1001' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="isp-after-get-finance-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Fields" expression="#[keysOf(payload) map $ as String]" is="#[MunitTools::equalTo(['orderId', 'invoiceNumber', 'totalPrice', 'taxAmount', 'paymentStatus'])]" />
			<munit-tools:assert-that doc:name="Total" expression="#[payload.totalPrice]" is="#[MunitTools::equalTo(120)]" />
		</munit:validation>
	</munit:test>

	<munit:test name="isp-unknown-order" description="ISP: unknown order returns 404">
		<munit:execution>
			<munit:set-event doc:name="Input">
				<munit:attributes value="#[{ uriParams: { orderId: 'ORD-0000' } }]" />
			</munit:set-event>
			<flow-ref doc:name="Run" name="isp-after-get-mobile-order" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="HTTP status" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(404)]" />
		</munit:validation>
	</munit:test>
</mule>
