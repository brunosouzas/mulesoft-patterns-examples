<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">


	<!--
		LSP BEFORE: order lookups have a contract - { orderId, status: PENDING|SHIPPED, totalPrice: number },
		and an unknown order is an APP:NOT_FOUND error. The legacy ERP adapter honours it. The adapter for the
		new ERP looks compatible (same field names) but breaks it: lower-case statuses, the price as text, and
		an empty 200 response instead of NOT_FOUND. The consumer does not fail loudly - it silently decides a
		pending order cannot be cancelled. Try GET /lsp/before/orders/ORD-1001?provider=legacy and ?provider=new.
	-->
	<flow name="lsp-before-get-order">
		<http:listener doc:name="Listener" config-ref="http-listener-config" path="/lsp/before/orders/{orderId}" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]" />
		</http:listener>
		<choice doc:name="Which provider?">
			<when expression="#[attributes.queryParams.provider == 'legacy']">
				<flow-ref doc:name="Legacy ERP" name="lsp-before-provider-legacy-erp" />
			</when>
			<when expression="#[attributes.queryParams.provider == 'new']">
				<flow-ref doc:name="New ERP" name="lsp-before-provider-new-erp" />
			</when>
			<otherwise>
				<raise-error type="APP:BAD_REQUEST" description="provider must be 'legacy' or 'new'" />
			</otherwise>
		</choice>
		<flow-ref doc:name="Business rule" name="lsp-before-summarise-order" />
	</flow>

	<!-- The consumer: written against the contract, not against a specific provider. -->
	<sub-flow name="lsp-before-summarise-order">
		<ee:transform doc:name="Summarise">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload ++ { canCancel: payload.status == "PENDING" }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>

	<!-- Provider 1: legacy ERP adapter. Honours the contract. -->
	<sub-flow name="lsp-before-provider-legacy-erp">
		<ee:transform doc:name="Call legacy ERP (simulated)">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var erp = {
	"ORD-1001": { ORD_NO: "ORD-1001", STS_CD: "P", TOT_AMT: "120.00" },
	"ORD-1002": { ORD_NO: "ORD-1002", STS_CD: "S", TOT_AMT: "75.50" }
}
---
erp[attributes.uriParams.orderId default ""]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<choice doc:name="Found?">
			<when expression="#[payload == null]">
				<raise-error type="APP:NOT_FOUND" description="Order not found" />
			</when>
		</choice>
		<ee:transform doc:name="To contract">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	orderId: payload.ORD_NO,
	status: payload.STS_CD match {
		case "P" -> "PENDING"
		case "S" -> "SHIPPED"
		else -> "UNKNOWN"
	},
	totalPrice: payload.TOT_AMT as Number
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>

	<!-- Provider 2 (BEFORE): same field names, different meaning. Not substitutable. -->
	<sub-flow name="lsp-before-provider-new-erp">
		<ee:transform doc:name="Call new ERP (simulated)">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var erp = {
	"ORD-1001": { id: "ORD-1001", state: "pending", amount: "120.00" },
	"ORD-1002": { id: "ORD-1002", state: "shipped", amount: "75.50" }
}
---
erp[attributes.uriParams.orderId default ""]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<ee:transform doc:name="To contract (almost)">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	orderId: payload.id,
	status: payload.state,
	totalPrice: payload.amount
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
