<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">


	<!--
		LSP AFTER: both adapters honour the whole contract - the shape, the value vocabulary (upper-case
		statuses, numeric price) and the behaviour for unknown orders (APP:NOT_FOUND). The consumer gets the
		same answer from either provider, so one can replace the other without the consumer noticing.
		The contract is in docs/contracts/solid/lsp-order-after.raml.
	-->
	<flow name="lsp-after-get-order">
		<http:listener doc:name="Listener" config-ref="http-listener-config" path="/lsp/after/orders/{orderId}" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]" />
		</http:listener>
		<choice doc:name="Which provider?">
			<when expression="#[attributes.queryParams.provider == 'legacy']">
				<flow-ref doc:name="Legacy ERP" name="lsp-after-provider-legacy-erp" />
			</when>
			<when expression="#[attributes.queryParams.provider == 'new']">
				<flow-ref doc:name="New ERP" name="lsp-after-provider-new-erp" />
			</when>
			<otherwise>
				<raise-error type="APP:BAD_REQUEST" description="provider must be 'legacy' or 'new'" />
			</otherwise>
		</choice>
		<flow-ref doc:name="Business rule" name="lsp-after-summarise-order" />
	</flow>

	<!-- The consumer: written against the contract, not against a specific provider. -->
	<sub-flow name="lsp-after-summarise-order">
		<ee:transform doc:name="Summarise">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload ++ { canCancel: payload.status == "PENDING" }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>

	<!-- Provider 1: legacy ERP adapter. Honours the contract. -->
	<sub-flow name="lsp-after-provider-legacy-erp">
		<ee:transform doc:name="Call legacy ERP (simulated)">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var erp = {
	"ORD-1001": { ORD_NO: "ORD-1001", STS_CD: "P", TOT_AMT: "120.00" },
	"ORD-1002": { ORD_NO: "ORD-1002", STS_CD: "S", TOT_AMT: "75.50" }
}
---
erp[attributes.uriParams.orderId default ""]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<choice doc:name="Found?">
			<when expression="#[payload == null]">
				<raise-error type="APP:NOT_FOUND" description="Order not found" />
			</when>
		</choice>
		<ee:transform doc:name="To contract">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	orderId: payload.ORD_NO,
	status: payload.STS_CD match {
		case "P" -> "PENDING"
		case "S" -> "SHIPPED"
		else -> "UNKNOWN"
	},
	totalPrice: payload.TOT_AMT as Number
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>

	<!-- Provider 2 (AFTER): translates the new ERP's vocabulary into the contract, including errors. -->
	<sub-flow name="lsp-after-provider-new-erp">
		<ee:transform doc:name="Call new ERP (simulated)">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var erp = {
	"ORD-1001": { id: "ORD-1001", state: "pending", amount: "120.00" },
	"ORD-1002": { id: "ORD-1002", state: "shipped", amount: "75.50" }
}
---
erp[attributes.uriParams.orderId default ""]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<choice doc:name="Found?">
			<when expression="#[payload == null]">
				<raise-error type="APP:NOT_FOUND" description="Order not found" />
			</when>
		</choice>
		<ee:transform doc:name="To contract">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	orderId: payload.id,
	status: upper(payload.state),
	totalPrice: payload.amount as Number
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
