<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<!--
		MESSAGE FILTER, AFTER: the work the filter guards is inside the route that lets the message through.
		POST /eip/stock/after/reservations { orderId, status, items }

		The Choice has one route per outcome, and nothing that depends on the filter comes after it:
		- PAID: reserve the stock, result RESERVED;
		- anything else: discard it (log it and answer DISCARDED), nothing is reserved.
		The answer is 200 in both cases: for the sender a discarded order is a normal outcome, not an error.

		The other way, and the one MuleSoft documents as the Mule 4 replacement for filters, is to raise an error
		when the message does not qualify: a Validation module validator (validation:is-true and the others,
		which raise VALIDATION errors; https://docs.mulesoft.com/mule-runtime/4.3/migration-filters) or a
		raise-error, handled with on-error-continue (in a Try, or in the flow's error handler). It ends the flow
		right there, but it uses errors for normal control flow and every discarded message passes through the
		error handling. This project keeps the filter in a Choice, because the discarded path is short and the
		Validation module is not a dependency here.
	-->
	<flow name="stock-after-reserve-paid-orders" doc:description="Message filter, after: reserves stock only for PAID orders; any other order is discarded inside the Choice and nothing after the Choice depends on the filter.">
		<http:listener doc:name="POST /eip/stock/after/reservations" config-ref="http-listener-config" path="/eip/stock/after/reservations" allowedMethods="POST">
			<http:response statusCode="#[vars.httpStatus default 200]" />
		</http:listener>
		<logger doc:name="INFO: Log reservation request" level="INFO" message="#['Stock reservation request (after) for orderId=' ++ (payload.orderId default 'none') ++ ', correlationId=' ++ correlationId]" />
		<flow-ref doc:name="Refer to sf-validate-stock-request" name="sf-validate-stock-request" />
		<choice doc:name="Pass Only Paid Orders">
			<when expression="#[payload.status == 'PAID']">
				<flow-ref doc:name="Refer to sf-reserve-stock-for-order" name="sf-reserve-stock-for-order" />
				<set-variable doc:name="SET vFilterResult" variableName="vFilterResult" value="RESERVED" />
			</when>
			<otherwise>
				<logger doc:name="WARN: Log discarded order" level="WARN" message="#['Discarded order ' ++ payload.orderId ++ ' with status ' ++ payload.status ++ ', correlationId=' ++ correlationId]" />
				<set-variable doc:name="SET vFilterResult" variableName="vFilterResult" value="DISCARDED" />
			</otherwise>
		</choice>
		<ee:transform doc:name="Build Reservation Response">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ orderId: payload.orderId, result: vars.vFilterResult }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
